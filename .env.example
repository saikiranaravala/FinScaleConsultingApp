# Copy to .env and fill in real values before running `docker compose up`.
# NEVER commit the real .env (see .gitignore).

# ---------------------------------------------------------------------------
# LibreChat core
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=3080
MONGO_URI=mongodb://mongodb:27017/LibreChat
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080

# FR-2: no anonymous/guest access.
ALLOW_REGISTRATION=false
ALLOW_SOCIAL_LOGIN=false

# Required by LibreChat. Generate real values before deploying, e.g.:
#   CREDS_KEY:          openssl rand -hex 32   (must be 32 bytes / 64 hex chars)
#   CREDS_IV:            openssl rand -hex 16   (must be 16 bytes / 32 hex chars)
#   JWT_SECRET / JWT_REFRESH_SECRET: openssl rand -hex 32
CREDS_KEY=REPLACE_ME_32_BYTE_HEX
CREDS_IV=REPLACE_ME_16_BYTE_HEX
JWT_SECRET=REPLACE_ME
JWT_REFRESH_SECRET=REPLACE_ME

# NFR-3: intentionally no OPENAI_API_KEY / ANTHROPIC_API_KEY / GOOGLE_KEY / etc.
# Only the FinScale custom endpoint below is configured. Do not add third-party
# LLM provider keys here without re-checking NFR-3.

# ---------------------------------------------------------------------------
# FinScale shim -> real vLLM serving endpoint (FinscaleNvidiaPlatform)
# INT-1: env-configured per environment, never hardcoded.
# ---------------------------------------------------------------------------
FINSCALE_VLLM_BASE_URL=http://localhost:8000/v1
FINSCALE_VLLM_API_KEY=
FINSCALE_CLIENTS_CONFIG=/config/clients.json
SHIM_PORT=4000

# ---------------------------------------------------------------------------
# LibreChat -> shim (librechat.yaml interpolates these; point at the shim,
# never directly at FINSCALE_VLLM_BASE_URL)
# ---------------------------------------------------------------------------
FINSCALE_SHIM_BASE_URL=http://shim:4000/v1
FINSCALE_SHIM_API_KEY=unused-placeholder
