# Native/non-Docker RunPod deployment env (see ../../DEPLOY_RUNPOD.md).
# Unlike the root .env.example (which targets Docker Compose service names like
# `mongodb`/`shim`), everything here runs as a plain OS process on the same Pod,
# so every URL is localhost.
#
# bootstrap.sh copies this to /workspace/FinScaleChat-data... actually to
# /workspace/FinScaleChat-config/.env on first run and symlinks it into the repo
# root as .env — edit the COPY under /workspace/FinScaleChat-config/.env, not
# this example file, so your edits survive this repo checkout being re-cloned.

HOST=0.0.0.0
PORT=3080
MONGO_URI=mongodb://127.0.0.1:27017/LibreChat
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080

# FR-2: no anonymous/guest access. Flip to false only long enough to register
# the first consultant account, then set this back to false and restart.
ALLOW_REGISTRATION=false
ALLOW_SOCIAL_LOGIN=false

# Generate real values: CREDS_KEY/JWT_* with `openssl rand -hex 32`, CREDS_IV with `-hex 16`.
CREDS_KEY=REPLACE_ME_32_BYTE_HEX
CREDS_IV=REPLACE_ME_16_BYTE_HEX
JWT_SECRET=REPLACE_ME
JWT_REFRESH_SECRET=REPLACE_ME

# NFR-3: intentionally no OPENAI_API_KEY / ANTHROPIC_API_KEY / etc.

# ---------------------------------------------------------------------------
# FinScale shim -> serve_vllm.py (same Pod, so loopback — NFR-1 is trivially
# satisfied since the request never leaves the Pod)
# ---------------------------------------------------------------------------
FINSCALE_VLLM_BASE_URL=http://127.0.0.1:8000/v1
FINSCALE_VLLM_API_KEY=
FINSCALE_CLIENTS_CONFIG=/FinScaleChat/config/clients.json
SHIM_PORT=4000

# ---------------------------------------------------------------------------
# LibreChat -> shim
# ---------------------------------------------------------------------------
FINSCALE_SHIM_BASE_URL=http://127.0.0.1:4000/v1
FINSCALE_SHIM_API_KEY=unused-placeholder

# Where LibreChat finds librechat.yaml in native mode (no Docker volume mount).
CONFIG_PATH=/FinScaleChat/librechat.yaml
